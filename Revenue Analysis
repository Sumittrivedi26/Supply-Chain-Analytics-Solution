-----best selling product by revenue category wise----
select productname, category, revenue from (select p.productname,p.category,
sum(s.unitssold * s.unitprice) as revenue,
dense_rank() over(partition by p.category order by revenue) as rnk from sales as s
left join products as p on s.productid = p.productid
group by p.productname, p.category
order by revenue desc)
where rnk = 1;
