----lets start finding the top 5 products based on revenue-----
select p.productname, sum(s.unitssold * s.unitprice) as revenue from sales as s
left join products as p on s.productid = p.productid
group by p.productname
order by revenue desc
limit 5;
------ another solution -------
with outer_cte as(
with cte as (
select s.*, p.* from sales as s
left join products as p on s.productid = p.productid)
select productname, sum(unitssold * unitprice) as revenue ,
dense_rank() over( order by revenue desc) as rnk from cte
group by productname)
select * from outer_cte where rnk <= 5;
-----sqlserver solution----
select top 5 p.productname, sum(s.unitssold * s.unitprice) as revenue from sales as s
left join products as p on s.productid = p.productid
group by p.productname
order by revenue desc;
---using cte inside another cte is not allowed in sqserver for that we have to create different
cte for each step
