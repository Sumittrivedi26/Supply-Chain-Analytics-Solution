insert into DateDim
select
d AS Date,
YEAR(d) AS Year,
MONTH(d) AS Month,
MONTHNAME(d) AS MonthName,
QUARTER(d) AS Quarter,
QUARTER(d) = QUARTER(CURRENT_DATE()) AS IsCurrentQuarter
FROM (
SELECT DATEADD(DAY, SEQ4(), '2024-01-01') AS d
FROM TABLE(GENERATOR(ROWCOUNT => 366)) -- 2024 is leap year
)
WHERE d <= '2024-12-31';


------sql serever version-------
with datecte as
(
select cast('2024-01-01' as date) as d
union all
select dateadd(day, 1, d) from datecte
where d < '2024-12-31'
)
insert into datedim
select
d as [date],
year(d) as [year],
month(d) as [month],
datename(month, d) as monthname,
datepart(quarter, d) as [quarter],
case
when year(d) = year(getdate())
and datepart(quarter, d) = datepart(quarter, getdate())
then 1 else 0
end as iscurrentquarter
from datecte
option (maxrecursion 366);



