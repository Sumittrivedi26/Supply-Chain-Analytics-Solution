Business Solution
--------total revenue per store in last quarter---------------
select quarter(max(date)) from sales; --- quarter for max(date) but quarter doesnt
work in sql swerver so we can use --
datepart(quarter, max(date))
select productid, (unitssold*unitprice) as revenue, date from sales where quarter(date) in
(select quarter(max(date)) from sales)
group by productid, revenue, date;
select st.storename, sum(s.unitssold*s.unitprice) as revenue from sales
as s join store as st on s.storeid = st.storeid
where quarter(date) in (select quarter(max(date)) from sales)
and year(date) in (select year(max(date)) from sales)
group by st.storename;
----one thing to keep in mind that quarter(date) doesnt woek in sqlserver so for that we
need to use Datepart(Quarter, date)
