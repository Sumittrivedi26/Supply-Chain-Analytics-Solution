----parameterising category---
set category_name = 'APPAREL';
select p.productname, sum(s.unitssold * s.unitprice) as revenue from sales as s
left join products as p on s.productid = p.productid
where category = $category_name
group by p.productname, p.category
order by revenue desc;
----SQL SERVER SOLUTION
declare @category_name varchar(50) = 'APPAREL';
select p.productname, sum(s.unitssold * s.unitprice) as revenue from sales as s
left join products as p on s.productid = p.productid
where category = @category_name
group by p.productname, p.category
order by revenue desc;
