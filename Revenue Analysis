Database & Table Creation


Create database Sales_Analysis;
create or replace table products(ProductID integer primary key, ProductName VARCHAR(50),
Category varchar(50));
create or replace table store(StoreID integer primary key, StoreName Varchar(100), Region
varchar(100));
Create or replace table DateDim (Date Date PRIMARY KEY, Year INTEGER, Month
INTEGER,MonthName VARCHAR(20),Quarter INTEGER, IsCurrentQuarter BOOLEAN);
create or replace table sales(TransactionID integer primary key, Date date, StoreID integer,
ProductID integer, UnitsSold integer,
UnitPrice decimal(10,2),
constraint fk_sales foreign key (ProductID) references products(ProductID),
constraint fk_store foreign key (StoreID) references store(StoreID),
constraint fk_date foreign key (Date) references Datedim(Date)
);


